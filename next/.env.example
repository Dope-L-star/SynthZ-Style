# Clarity solo se puede habilitar en una edición realmente exclusiva para adultos (18+).
# Estos valores se incorporan durante el build de Next.js; cambiarlos en Cloudflare sin reconstruir no basta.
# Las flags de audiencia, control de edad y revisión son declaraciones de release; no implementan por sí mismas verificación de edad ni controles de acceso.
NEXT_PUBLIC_CLARITY_ENABLED=false
NEXT_PUBLIC_CLARITY_AUDIENCE_18_PLUS=false
NEXT_PUBLIC_SYMPHORIA_ADULT_ONLY_RELEASE=false
NEXT_PUBLIC_SYMPHORIA_AGE_CONTROL_VERIFIED=false
NEXT_PUBLIC_CLARITY_PRIVACY_REVIEWED=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=z5es3kuqoz
