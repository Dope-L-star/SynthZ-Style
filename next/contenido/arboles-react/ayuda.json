":"text","value":"\n"},{"type":"element","tag":"section","attrs":{"class":"card tldr"},"children":[{"type":"element","tag":"h2","attrs":{},"children":[{"type":"text","value":"Need a person?"}]},{"type":"element","tag":"p","attrs":{},"children":[{"type":"text","value":"Prime, ZFlow or Symmetrix answer you inside the page, even if you close the tab (you need your free account). For ideas or bugs, tell us what to improve."}]},{"type":"element","tag":"div","attrs":{"class":"acts"},"children":[{"type":"element","tag":"a","attrs":{"class":"go","href":"chat.html?ayuda=equipo"},"children":[{"type":"text","value":"Talk to the team"}]},{"type":"element","tag":"a","attrs":{"href":"chat.html?ayuda=mejorar"},"children":[{"type":"text","value":"Tell us what to improve"}]},{"type":"element","tag":"a","attrs":{"href":"chat.html?ayuda=synthonia"},"children":[{"type":"text","value":"Ask SynthonIA"}]}]}]},{"type":"text","value":"\n"},{"type":"element","tag":"section","attrs":{"class":"card"},"children":[{"type":"element","tag":"h2","attrs":{},"children":[{"type":"text","value":"Frequently asked questions"}]},{"type":"element","tag":"details","attrs":{},"children":[{"type":"element","tag":"summary","attrs":{},"children":[{"type":"text","value":"Is SymphorIA free?"}]},{"type":"element","tag":"p","attrs":{},"children":[{"type":"text","value":"Yes. It is in beta and free. Every day you get your EnerX, the battery for the connected AIs; it recharges at midnight. Without an account you can try 5 messages a day."}]}]},{"type":"element","tag":"details","attrs":{},"children":[{"type":"element","tag":"summary","attrs":{},"children":[{"type":"text","value":"Do I need an email to sign up?"}]},{"type":"element","tag":"p","attrs":{},"children":[{"type":"text","value":"No. Just a username and a password. When you sign up we give you a recovery code: keep it somewhere safe."}]}]},{"type":"element","tag":"details","attrs":{},"children":[{"type":"element","tag":"summary","attrs":{},"children":[{"type":